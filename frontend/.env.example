# Copy to `.env.local`:  cp .env.example .env.local

# FastAPI base URL that /api/* is proxied to (resolved at build/start of Next.js).
BACKEND_URL=http://localhost:8000

# Must match COOKIE_NAME in backend/.env — the proxy uses it to detect a session.
AUTH_COOKIE_NAME=access_token

# Shown in the sidebar and on the login page.
NEXT_PUBLIC_APP_NAME=StockSense
