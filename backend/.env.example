# Copy to `.env` and adjust:  cp .env.example .env
# Generate a real secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_NAME=StockSense API
# development | production  (production hides /docs and rejects the sample JWT secret)
ENVIRONMENT=development

# --- MongoDB ---------------------------------------------------------------
# Atlas:         mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=stocksense

# --- Auth ------------------------------------------------------------------
JWT_SECRET_KEY=dev-only-secret-change-me-dev-only-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
COOKIE_NAME=access_token
# Set to true when served over HTTPS (always, in production)
COOKIE_SECURE=false
# lax | strict | none
COOKIE_SAMESITE=lax

# --- First administrator (created on first start, only if the users collection is empty)
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeMe123!
FIRST_ADMIN_NAME=Administrator

# Let visitors create their own account (POST /api/auth/register). false = admins create users only.
ALLOW_REGISTRATION=true

# --- Server / CORS ---------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated. Only needed if the browser calls the API directly (the
# Next.js frontend proxies /api/* so it normally does not need CORS).
CORS_ORIGINS=http://localhost:3000
