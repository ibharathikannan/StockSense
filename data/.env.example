# Copy to data/.env; keep credentials local. Collectors also read exported variables.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPHA_VANTAGE_API_KEY=
# SEC requires an identifying organization/name and a real contact email.
SEC_USER_AGENT=

# Optional shared-data PostgreSQL migration (not the web application's database).
PGHOST=
PGPORT=5432
PGDATABASE=stocksense_data
PGUSER=
PGSSLMODE=require
PGCONNECT_TIMEOUT=15
# Prefer --prompt-password or a local .pgpass file; never commit passwords.
PGPASSWORD=
